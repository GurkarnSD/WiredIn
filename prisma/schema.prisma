generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode      = "prisma"
}

model Credentials {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid())
  displayName String   @unique
  email       String   @unique
  password    String
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ActivateToken ActivateToken[]
  ResetToken    ResetToken[]
}

model ActivateToken {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  activatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  credentials   Credentials @relation(fields: [credsId], references: [id], onDelete: Cascade)
  credsId Int

  @@index([credsId])
}

model ResetToken {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  resetAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  credentials   Credentials @relation(fields: [credsId], references: [id], onDelete: Cascade)
  credsId Int

  @@index([credsId])
}

model User {
  id          Int          @id @default(autoincrement())
  uid         String       @unique @default(uuid())
  email       String       @unique
  displayName String       @unique
  title       String?
  bio         String?
  github      String?
  profilePic  String       @default("default/Profile.png")
  bannerPic   String       @default("default/Banner.jpg")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  following   User[]       @relation("Following")
  followers   User[]       @relation("Following")
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  posts       Post[]
  likedPosts  Post[]       @relation("LikedPosts")
}

model Skill {
  id          Int          @id @default(autoincrement())
  name        String
  learnedIn   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String
  experiences Experience[]
  projects    Project[]

  @@index([userId])
}

model Experience {
  id          Int       @id @default(autoincrement())
  title       String
  company     String
  image       String?
  description String?   @db.VarChar(1000)
  skills      Skill[]
  start       DateTime
  end         DateTime?
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.VarChar(1000)
  deployment  String?
  source      String?
  start       DateTime
  end         DateTime?
  current     Boolean   @default(false)
  skills      Skill[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String

  @@index([userId])
}

model Post {
  id          Int       @id @default(autoincrement())
  text        String    @db.VarChar(1200)
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String
  likes       User[]    @relation("LikedPosts")

  @@index([userId])
}