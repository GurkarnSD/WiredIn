generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL")
}

model Credentials {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid())
  displayName String   @unique
  email       String   @unique
  password    String
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ActivateToken ActivateToken[]
  ResetToken    ResetToken[]
  NameChange   NameChange[]
}

model ActivateToken {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  activatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  credentials   Credentials  @relation(fields: [credsId], references: [id], onDelete: Cascade)
  credsId Int

  @@index([credsId])
}

model ResetToken {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  resetAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  credentials   Credentials  @relation(fields: [credsId], references: [id], onDelete: Cascade)
  credsId       Int

  @@index([credsId])
}

model NameChange {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())
  credentials   Credentials  @relation(fields: [credsId], references: [id], onDelete: Cascade)
  credsId       Int

  @@index([credsId])
}

model User {
  id          Int          @id @default(autoincrement())
  uid         String       @unique @default(uuid())
  email       String       @unique
  displayName String       @unique
  title       String?
  bio         String?
  github      String?
  profilePic  String       @default("default/Profile.png")
  bannerPic   String       @default("default/Banner.jpg")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  following   User[]       @relation("Following")
  followers   User[]       @relation("Following")
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  posts       Post[]
  contracts   Contract[]
  jobs        Job[]  
  likedPosts  Post[]       @relation("LikedPosts")
  comments    Comment[]    @relation("PostComments")
  responses   Response[]   @relation("CommentResponses")
  likedComments Comment[]  @relation("CommentLikes")
  likedResponses Response[] @relation("ResponseLikes")
  messages   Message[]    @relation("UserMessages")
  chatRooms  ChatRoom[]   @relation("ChatRoomUsers")
  contractApps Contract[] @relation("ContractApplicants")
  jobApps     Job[]       @relation("JobApplicants")
  contactForms ContactForm[]
}

model Skill {
  id          Int          @id @default(autoincrement())
  skill       SkillOption  @relation(fields: [name], references: [skill])
  name        String
  learnedIn   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String
  experiences Experience[]
  projects    Project[]

  @@index([userId])
  @@index([name])
}

model Experience {
  id          Int       @id @default(autoincrement())
  title       String
  company     String
  image       String?
  description String?   @db.VarChar(1000)
  skills      Skill[]
  start       DateTime
  end         DateTime?
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.VarChar(1000)
  deployment  String?
  source      String?
  start       DateTime
  end         DateTime?
  current     Boolean   @default(false)
  skills      Skill[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId      String

  @@index([userId])
}

model Post {
  id        Int       @id @default(autoincrement())
  uid       String    @unique @default(uuid())
  text      String    @db.VarChar(1200)
  images    Image[]   @relation("PostImages")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  likes     User[]    @relation("LikedPosts")
  comments  Comment[] @relation("PostComments")

  @@index([userId])
}

model Comment {
  id        Int        @id @default(autoincrement())
  text      String     @db.VarChar(1200)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation("PostComments", fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  post      Post       @relation("PostComments", fields: [postId], references: [uid], onDelete: Cascade)
  postId    String
  responses Response[] @relation("CommentResponses")
  likes     User[]     @relation("CommentLikes")

  @@index([userId])
  @@index([postId])
}

model Image {
  id     Int    @id @default(autoincrement())
  key    String
  postId String
  post   Post   @relation("PostImages", fields: [postId], references: [uid], onDelete: Cascade)

  @@index([postId])
}

model Response {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("CommentResponses", fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  comment   Comment  @relation("CommentResponses", fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  likes     User[]   @relation("ResponseLikes")

  @@index([userId])
  @@index([commentId])
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("ChatRoomUsers")
  messages  Message[] @relation("ChatRoomMessages")

  @@index([uid])
}

model Message {
  id        Int        @id @default(autoincrement())
  text      String     @db.VarChar(1200)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation("UserMessages", fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  chatRoom  ChatRoom   @relation("ChatRoomMessages", fields: [chatRoomId], references: [uid], onDelete: Cascade)
  chatRoomId String
  attachments Attachment[]

  @@index([userId])
  @@index([chatRoomId])
}

model Attachment {
  id        Int        @id @default(autoincrement())
  key       String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId Int

  @@index([messageId])
}

model Contract {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  title     String    @db.VarChar(100)
  description String? @db.VarChar(2000)
  location  String?   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  skills    SkillOption[] @relation("ContractSkills")
  tags      TagOption[]   @relation("ContractTags")
  applicants User[]  @relation("ContractApplicants")

  @@index([userId])
}

model Job {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  title     String    @db.VarChar(100)
  description String? @db.VarChar(2000)
  location  String?   @db.VarChar(50)
  hourly    Float?
  salary    Int?
  start DateTime?
  end   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  userId    String
  skills    SkillOption[] @relation("JobSkills")
  tags      TagOption[]   @relation("JobTags")
  applicants User[]  @relation("JobApplicants")

  @@index([userId])
}

model SkillOption {
  skill      String    @id
  contracts Contract[] @relation("ContractSkills")
  jobs      Job[]      @relation("JobSkills")
  skills    Skill[]
}

model TagOption {
  tag      String   @id
  contracts Contract[] @relation("ContractTags")
  jobs     Job[]      @relation("JobTags")
}

model ContactForm {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  type      String
  message   String
  user      User     @relation(fields: [userId], references: [uid])
  userId    String
  createdAt DateTime @default(now())
}